  "overrides": {
    "qs": "^6.16.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@vitest/browser-playwright": "^5.1.0",
    "dependency-cruiser": "^18.7.2",
    "istanbul-lib-instrument": "^6.0.3",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "typescript": "~6.0.0",
    "vitest": "^5.0.3"
  }
}
