{
  "name": "lottery-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "check:swa": "node scripts/check-swa-config.mjs"
