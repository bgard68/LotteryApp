<Project>
  <ItemGroup>
    <PackageVersion Include="Dapper" Version="2.1.89" />
    <PackageVersion Include="dbup-sqlite" Version="6.0.4" />
    <PackageVersion Include="dbup-sqlserver" Version="7.2.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!-- Interactive API docs UI. .NET 9+ dropped Swashbuckle from the templates:
         AddOpenApi() serves the document only, with no UI. Scalar renders it. -->
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.14" />
    <!-- Transitive-vulnerability lifts: newer patched versions of packages pulled
         in by Microsoft.Data.Sqlite and Microsoft.AspNetCore.OpenApi. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- GHSA-846f-f764-76mx (High) / GHSA-2fmv-rv2c-59x7 (Moderate): quadratic CPU exhaustion in
         SignedCms.CheckSignature and EnvelopedCms.Decode. Arrives as 9.0.18 via
         Microsoft.Data.SqlClient 7.1.1 (directly and through dbup-sqlserver), which still
         declares the vulnerable version even on its newest line - so lifting it here is the only
         fix available. Patched in 9.0.21 and 10.0.13; pinned on 10.0.x to match net10.0. Remove
         once Microsoft.Data.SqlClient ships a fixed dependency. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
</Project>
