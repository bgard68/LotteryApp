<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\Lottery.Application\Lottery.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lottery.Infrastructure.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="dbup-sqlite" />
    <PackageReference Include="dbup-sqlserver" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <!-- Security lift, not a direct dependency of this code: see Directory.Packages.props. The
         reference has to exist for the version to win over the transitive one, and this is the
         project that roots the chain, so it covers Api and the test projects too. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Migration scripts + seed snapshots ship inside the assembly so a
         deployment is a single binary with no loose-file path issues. -->
    <EmbeddedResource Include="Persistence\Migrations\Sqlite\*.sql" />
    <EmbeddedResource Include="Persistence\Migrations\SqlServer\*.sql" />
    <EmbeddedResource Include="Seeding\Data\*.json" />
  </ItemGroup>
</Project>
